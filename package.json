{
  "name": "moltnet-pddl-designer",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Experimental natural-language to planning-domain design workflow run as contracted MoltNet tasks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/moltnet-pddl-designer.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "dev": "tsx server/main.ts --dev",
    "start": "tsx server/main.ts",
    "build": "vite build",
    "test:browser": "playwright test",
    "format:check": "prettier --check ui server src/provenance.ts src/saved-run.ts",
    "lint": "eslint . --max-warnings 0",
    "secretlint": "secretlint --no-gitignore \"**/*\""
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@themoltnet/os-keyring": "0.5.0",
    "@themoltnet/sdk": "^0.153.0",
    "@themoltnet/tasks-orchestrator": "^0.5.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "^1.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.6"
  }
}
