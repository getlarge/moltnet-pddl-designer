{
  "name": "moltnet-pddl-designer",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Experimental natural-language to planning-domain design workflow run as contracted MoltNet tasks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/moltnet-pddl-designer.git"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "cli": "tsx apps/cli/src/cli.ts",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "start": "tsx apps/server/src/main.ts",
    "build": "pnpm -r --if-present run build",
    "test:browser": "playwright test",
    "format:check": "prettier --check apps packages scripts/dev.mjs eslint.config.mjs tooling",
    "lint": "eslint . --max-warnings 0 && pnpm test:boundaries",
    "secretlint": "secretlint --no-gitignore \"**/*\"",
    "db:up": "docker compose up -d --wait",
    "db:init": "bash scripts/init-db.sh",
    "test:durable": "vitest run --config vitest.durable.config.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "dev:server": "tsx apps/server/src/main.ts --dev",
    "test:boundaries": "node --test tooling/boundaries.test.mjs",
    "eval:temporal": "node --import tsx scripts/eval/score-temporal.ts",
    "eval:temporal:live": "sh scripts/eval/run-temporal.sh",
    "eval:temporal:detect": "sh scripts/eval/run-temporal-detection.sh",
    "eval:temporal:inputs": "node --import tsx scripts/eval/temporal-inputs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pddl/contracts": "workspace:*",
    "@pddl/domain": "workspace:*",
    "@pddl/evals": "workspace:*",
    "@pddl/persistence": "workspace:*",
    "@pddl/workflows": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@themoltnet/sdk": "^0.153.0",
    "@themoltnet/tasks-orchestrator": "^0.5.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "5.3.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fastify": "^5.12.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.6"
  }
}
