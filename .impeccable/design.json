  "narrative": {
    "donts": [
      "Don't assign a different accent hue to every stage.",
      "Don't hide model omissions or silently fabricate source references.",
      "Don't use decorative imagery, paper texture or ornamental shadows.",
      "Don't use color alone to communicate a correction, selection or completed state."
    ],
    "dos": [
      "Do connect selected annotations to recorded source evidence, or label missing references.",
      "Do keep state labels, borders and disclosure controls alongside color.",
      "Do keep description and construction visibility controls as buttons with Show/Hide wording.",
      "Do present plain-language meaning before optional model notation.",
      "Do distinguish a passed model check from a claim that the described process is correct."
    ],
    "keyCharacteristics": [
      "Flat sheets and fine rules, without decorative imagery.",
      "Readable source prose beside compact controls and annotations.",
      "Linked selection, explicit findings, and recorded gate status.",
      "Progressive disclosure for technical detail."
    ],
    "northStar": "Galley Proof",
    "overview": "A working proof for a process expert in ordinary daylight. The expert's sentences remain the source of truth; numbered lines and keyed model annotations make their relationship inspectable. The interface has its own identity, separate from MoltNet branding.\n\nWhite stock, dark ink, book text and fine rules create a quiet editing desk. Color directs attention to the current work or communicates a labeled outcome; it does not decorate individual workflow stages. Construction remains available without dominating the plain-language review.",
    "rules": [
      {
        "body": "Blue identifies focus and selection; green identifies achieved or added state; amber asks for review or marks facts made false; red identifies corrections and errors. Keep the accompanying labels and structural cues.",
        "name": "The Meaning Before Color Rule",
        "section": "colors"
      },
      {
        "body": "Use Literata for source prose and principal headings, Public Sans for operation and interpretation, and mono for formal notation and numeric references.",
        "name": "The Two Reading Voices Rule",
        "section": "typography"
      },
      {
        "body": "Use rules, spacing and tonal selection to separate regions. Do not add ornamental shadows or simulated paper texture.",
        "name": "The Flat Sheet Rule",
        "section": "elevation"
      }
    ]
  },
  "schemaVersion": 2,
  "title": "Design System: Galley Proof"
